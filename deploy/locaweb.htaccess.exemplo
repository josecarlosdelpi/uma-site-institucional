# MODELO DE CONFIGURACAO PARA MIGRACAO UMA — NAO ATIVAR SEM APROVACAO MILENA + JARDEL
# Validar mod_rewrite, Proxy/SSL e regras do servidor Locaweb com ambiente de homologacao.
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Dominio oficial preferencial (sem www) + HTTPS.
# ATENCAO: se o servidor estiver atras de proxy HTTPS, ajuste esta regra para evitar loop!
RewriteCond %{HTTP_HOST} ^(www\.)?universodasmangueiras\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.universodasmangueiras\.com\.br$ [NC]
RewriteRule ^ https://universodasmangueiras.com.br%{REQUEST_URI} [R=301,L,NE]

# URLs do site anterior sem barra: apontar para as novas paginas equivalentes.
RewriteRule ^(mangueiras-intercooler|mangueira-radiador|mangueiras-de-ar-quente|mangueira-filtro-ar-automotivo|mangueira-de-respiro|tubo-de-agua-automotivo|adaptador-mangueira-automotiva|abracadeiras-automotivas|contato-distribuidor-mangueiras-automotivas-sc)$ /$1/ [R=301,L,NE]

# Canonicalizar o index.html inicial sem criar loop nos subdiretorios.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]
</IfModule>
